From: Inga Pilchin <inga.pilchin@realsenseai.com>
Date: Sun, 4 Oct 2026 18:00:00 +0300
Subject: [PATCH] media: tegra: carrier rows for compressed colour, cleared buffers

A compressed frame travels as lines of one fixed length whatever the
picture resolution, so its transport geometry is substituted rather than
scaled. A row declares that length as its carrier line length; the
capture descriptor, the stride and the committed size then follow from
it, and the sites that need the line count share one helper.

Two rows are added, H.264 and JPEG, on private RealSense media-bus codes,
so no other sensor matches them. Both report bytesperline 0, as V4L2
requires for compressed formats, and set the variable-height flag, since
a frame may stop before its last carrier line.

The VI writes only the lines that arrive and never touches the rest of
the buffer, so a short frame was followed by whatever an earlier, larger
frame left there, which broke H.264 decoding. Every buffer of a
variable-height row is now cleared when it is queued, before the capture
can be armed: driver buffers through their kernel mapping, user memory
in the caller's context, shared buffers through their mapping inside a
CPU-access bracket. A buffer that cannot be cleared is refused at queue
time. The frame is then followed only by zeros and is reported at the
buffer size, like every other row.

A capture that reports its channel in error is delivered by the stock
path; for a variable-height row it is failed, since the frame's end is
known only from its data. The existing variable-length row gets both
behaviours too.

Signed-off-by: Inga Pilchin <inga.pilchin@realsenseai.com>
---
  .../media/platform/tegra/camera/vi/channel.c  | 73 +++++++++++++++++++
  .../media/platform/tegra/camera/vi/vi5_fops.c | 16 +++-
  .../platform/tegra/camera/vi/vi5_formats.h    | 22 ++++++
  include/media/tegra_camera_core.h             | 19 +++++
  4 files changed, 129 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/tegra/camera/vi/channel.c b/drivers/media/platform/tegra/camera/vi/channel.c
index 3c2518b9..fddb2b04 100644
--- a/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/drivers/media/platform/tegra/camera/vi/channel.c
@@ -22,6 +22,7 @@
 #include <linux/bitmap.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/dma-buf.h>
 #include <linux/nvhost.h>
 #include <linux/lcm.h>
 #include <linux/list.h>
@@ -31,6 +32,7 @@
 #include <linux/sched.h>
 #include <linux/slab.h>
 #include <linux/semaphore.h>
+#include <linux/uaccess.h>
 #include <linux/arm64-barrier.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-event.h>
@@ -345,6 +347,18 @@ static void tegra_channel_update_format(struct tegra_channel *chan,
 	/* Transport rows may exceed V4L2 rows (tegra_camera_core.h). */
 	chan->format.sizeimage = tegra_frac_scale(chan->format.sizeimage,
 					&chan->fmtinfo->frame_y_scale);
+
+	/* Carrier lines are substituted, not scaled: they do not follow the
+	 * picture, so there is no picture line pitch to report. */
+	if (chan->fmtinfo->carrier_line_bytes) {
+		u32 lines = tegra_carrier_lines(chan->fmtinfo,
+						chan->format.width,
+						chan->format.height);
+
+		chan->format.bytesperline = 0;
+		chan->format.sizeimage =
+			chan->fmtinfo->carrier_line_bytes * lines;
+	}
 }
 
 static void tegra_channel_fmts_bitmap_init(struct tegra_channel *chan)
@@ -875,12 +889,62 @@ void tegra_channel_dealloc_buffer_queue(struct tegra_channel *chan)
 		devm_kfree(vi_unit_dev, chan->buffers);
 }
 
+/* A variable-height frame may stop early and the VI never touches the rest,
+ * so clear the buffer at every queue: a short frame is then followed by
+ * zeros, never by an earlier frame. vb2 calls this after mapping the buffer
+ * and syncs USERPTR caches right after it; MMAP is coherent; a DMABUF syncs here. */
+static int tegra_channel_clear_buffer(struct tegra_channel *chan,
+				      struct vb2_buffer *vb)
+{
+	size_t len = min_t(size_t, chan->format.sizeimage,
+			   vb2_plane_size(vb, 0));
+	struct dma_buf *dbuf = vb->planes[0].dbuf;
+	void *vaddr;
+	int err;
+
+	/* Process context of the QBUF caller, whose memory this is. */
+	if (vb->memory == VB2_MEMORY_USERPTR) {
+		if (clear_user((void __user *)vb->planes[0].m.userptr, len))
+			return -EFAULT;
+		return 0;
+	}
+
+	vaddr = vb2_plane_vaddr(vb, 0);
+	if (!vaddr)
+		return -EFAULT;
+
+	if (vb->memory != VB2_MEMORY_DMABUF) {
+		memset(vaddr, 0, len);
+		/* Coherent MMAP is not synced by vb2: make the zeros visible. */
+		wmb();
+		return 0;
+	}
+
+	err = dma_buf_begin_cpu_access(dbuf, DMA_BIDIRECTIONAL);
+	if (err)
+		return err;
+	memset(vaddr, 0, len);
+	return dma_buf_end_cpu_access(dbuf, DMA_BIDIRECTIONAL);
+}
+
 static int tegra_channel_buffer_prepare(struct vb2_buffer *vb)
 {
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
 	struct tegra_channel *chan = vb2_get_drv_priv(vb->vb2_queue);
 	struct tegra_channel_buffer *buf = to_tegra_channel_buffer(vbuf);
 
+	/* Refused when it cannot be cleared, never captured into uncleared. */
+	if (chan->fmtinfo->flags & TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT) {
+		int err = tegra_channel_clear_buffer(chan, vb);
+
+		if (err) {
+			dev_err_ratelimited(chan->vi->dev,
+				"buffer %u not cleared: %d\n",
+				vb->index, err);
+			return err;
+		}
+	}
+
 	buf->chan = chan;
 	vb2_set_plane_payload(&vbuf->vb2_buf, 0, chan->format.sizeimage);
 #if IS_ENABLED(CONFIG_VIDEOBUF2_DMA_CONTIG)
@@ -2298,6 +2362,15 @@ __tegra_channel_try_format(struct tegra_channel *chan,
 	pix->sizeimage = tegra_frac_scale(pix->sizeimage,
 					  &vfmt->frame_y_scale);
 
+	/* Same substitution as tegra_channel_update_format, or try and set
+	 * disagree on the buffer size. */
+	if (vfmt->carrier_line_bytes) {
+		u32 lines = tegra_carrier_lines(vfmt, pix->width, pix->height);
+
+		pix->bytesperline = 0;
+		pix->sizeimage = vfmt->carrier_line_bytes * lines;
+	}
+
 	return ret;
 }
 
diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
index 293a410d..c8e39922 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -433,6 +433,15 @@ static void vi5_setup_surface(struct tegra_channel *chan,
 		width = roundup(width, chan->fmtinfo->frame_x_align);
 	height = tegra_frac_scale(height, &chan->fmtinfo->frame_y_scale);
 
+	/* Carrier lines: programmed via the same helpers as the format path.
+	 * After the gang substitution, so it wins over gang. */
+	if (chan->fmtinfo->carrier_line_bytes) {
+		width = tegra_carrier_line_pixels(chan->fmtinfo);
+		height = tegra_carrier_lines(chan->fmtinfo, chan->format.width,
+					     chan->format.height);
+		bpl = chan->fmtinfo->carrier_line_bytes;
+	}
+
 	memcpy(desc, &capture_template, sizeof(capture_template));
 	memset(desc_memoryinfo, 0, sizeof(*desc_memoryinfo));
 
@@ -461,7 +470,7 @@ static void vi5_setup_surface(struct tegra_channel *chan,
 	}
 
 	desc_memoryinfo->surface[0].base_address = offset;
-	desc_memoryinfo->surface[0].size = chan->format.bytesperline * height;
+	desc_memoryinfo->surface[0].size = bpl * height;
 	desc->ch_cfg.atomp.surface_stride[0] = bpl;
 	if (chan->fmtinfo->fourcc == V4L2_PIX_FMT_NV16) {
 		desc_memoryinfo->surface[1].base_address = offset + chan->format.sizeimage / 2;
@@ -659,6 +668,11 @@ static void vi5_capture_dequeue(struct tegra_channel *chan,
 				chan->queue_error = true;
 				dev_err(vi->dev, "uncorr_err: flags %d, err_data %d\n",
 					descr->status.flags, descr->status.err_data);
+				/* Stock delivers this frame; a variable-height frame's
+				 * end is only known from its data, so it is failed. */
+				if (chan->fmtinfo->flags &
+				    TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT)
+					frame_err = true;
 			} else if ((chan->fmtinfo->flags &
 				    TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT) &&
 				   descr->status.err_data ==
diff --git a/drivers/media/platform/tegra/camera/vi/vi5_formats.h b/drivers/media/platform/tegra/camera/vi/vi5_formats.h
index d67100ac..bd613fcd 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_formats.h
+++ b/drivers/media/platform/tegra/camera/vi/vi5_formats.h
@@ -82,6 +82,10 @@ enum tegra_image_format {
 	TEGRA_IMAGE_FORMAT_T_DPCM_RAW20,
 };
 
+/* Carrier row width in bytes, the same for every compressed profile. Must equal
+ * the camera's; a cross-repository check asserts it. */
+#define RS_CARRIER_ROW_BYTES	1280U
+
 static const struct tegra_video_format vi5_video_formats[] = {
 	/* RAW 6: TODO */
 
@@ -233,6 +237,24 @@ static const struct tegra_video_format vi5_video_formats[] = {
 				0,			/* frame_x align */
 				TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT,	/* flags */
 				0),			/* carrier line bytes */
+	// H.264 and JPEG on the 8-bit carrier: own rows so each stays selectable.
+	// Fixed carrier lines, and a frame may stop before the last of them.
+	TEGRA_VIDEO_FORMAT_EXTENDED(RAW8, 8, RS_H264_1X8, 1, 1, T_R8,
+				RAW8, H264, "H.264 over RAW8",
+				0, 0,			/* no dt/pixfmt override */
+				1, 1,			/* frame_x scale */
+				1, 1,			/* frame_y scale */
+				0,			/* frame_x align */
+				TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT,	/* flags */
+				RS_CARRIER_ROW_BYTES),	/* carrier line bytes */
+	TEGRA_VIDEO_FORMAT_EXTENDED(RAW8, 8, RS_JPEG_1X8, 1, 1, T_R8,
+				RAW8, MJPEG, "JPEG over RAW8",
+				0, 0,			/* no dt/pixfmt override */
+				1, 1,			/* frame_x scale */
+				1, 1,			/* frame_y scale */
+				0,			/* frame_x align */
+				TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT,	/* flags */
+				RS_CARRIER_ROW_BYTES),	/* carrier line bytes */
 
 };
 
diff --git a/include/media/tegra_camera_core.h b/include/media/tegra_camera_core.h
index e197d647..65d34e3c 100644
--- a/include/media/tegra_camera_core.h
+++ b/include/media/tegra_camera_core.h
@@ -171,6 +171,25 @@ struct tegra_video_format {
  * fault is then delivered as a good frame (payload carries its length). */
 #define TEGRA_VIDEO_FORMAT_FLAG_VARIABLE_HEIGHT		BIT(0)
 
+/* A carrier-line frame's size budget is the picture with each line padded
+ * to this many bytes, as the camera sizes it. */
+#define TEGRA_VARLEN_ROW_ALIGN		64U
+
+/* Lines of carrier_line_bytes that hold the budget; every site that sizes
+ * a carrier-line frame uses this, so they cannot disagree. */
+static inline u32 tegra_carrier_lines(const struct tegra_video_format *fmt,
+				      u32 width, u32 height)
+{
+	return DIV_ROUND_UP(roundup(width, TEGRA_VARLEN_ROW_ALIGN) *
+			    height, fmt->carrier_line_bytes);
+}
+
+/* frame_x counts pixels of the wire data type, not bytes. */
+static inline u32 tegra_carrier_line_pixels(const struct tegra_video_format *fmt)
+{
+	return fmt->carrier_line_bytes * BITS_PER_BYTE / fmt->width;
+}
+
 #define	TEGRA_VIDEO_FORMAT(VF_CODE, BPP, MBUS_CODE, FRAC_BPP_NUM,	\
 	FRAC_BPP_DEN, FORMAT, DATA_TYPE, FOURCC, DESCRIPTION)		\
 {									\
