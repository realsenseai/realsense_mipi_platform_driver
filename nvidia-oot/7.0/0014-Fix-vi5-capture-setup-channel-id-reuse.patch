From 7ec5786200475a8a6ebf4be58bc7f75b4f0285d9 Mon Sep 17 00:00:00 2001
From: Yogev Modlin <yogev.modlin@realsenseai.com>
Date: Mon, 28 Sep 2026 13:27:38 +0300
Subject: [PATCH] media: tegra: survive VI5 channel-id reuse during capture
 setup

RTCPU frees a capture channel id when it answers a release, but the
releasing stream unregisters that id's IVC callbacks only afterwards. A
setup running concurrently on another stream can be handed the same id
and fail tegra_capture_ivc_notify_chan_id() with -EBUSY.

That failure left capture->channel_id set while freeing unpins_list, so
the following shutdown released and unregistered the id on behalf of the
stream that owns it (IVC timeout, RTCPU reboot, every camera fails) and
then dereferenced the NULL unpins_list in vi_capture_request_unpin().

Wait briefly for the stale callback to clear before giving up, reset
channel_id on the setup failure path, and make request unpin tolerate a
missing unpins list.

Signed-off-by: Yogev Modlin <yogev.modlin@realsenseai.com>
---
 .../tegra/camera/fusa-capture/capture-vi-channel.c     |  5 +++++
 .../platform/tegra/camera/fusa-capture/capture-vi.c    |  3 +++
 drivers/platform/tegra/rtcpu/capture-ivc.c             | 10 ++++++++++
 3 files changed, 18 insertions(+)

diff --git a/drivers/media/platform/tegra/camera/fusa-capture/capture-vi-channel.c b/drivers/media/platform/tegra/camera/fusa-capture/capture-vi-channel.c
index e36c665..abee973 100644
--- a/drivers/media/platform/tegra/camera/fusa-capture/capture-vi-channel.c
+++ b/drivers/media/platform/tegra/camera/fusa-capture/capture-vi-channel.c
@@ -194,6 +194,11 @@ void vi_capture_request_unpin(
 	}
 
 	mutex_lock(&capture->unpins_list_lock);
+	if (capture->unpins_list == NULL ||
+	    buffer_index >= capture->queue_depth) {
+		mutex_unlock(&capture->unpins_list_lock);
+		return;
+	}
 	unpins = &capture->unpins_list[buffer_index];
 
 	if (unpins->num_unpins != 0) {
diff --git a/drivers/media/platform/tegra/camera/fusa-capture/capture-vi.c b/drivers/media/platform/tegra/camera/fusa-capture/capture-vi.c
index 9df15aa..721c780 100644
--- a/drivers/media/platform/tegra/camera/fusa-capture/capture-vi.c
+++ b/drivers/media/platform/tegra/camera/fusa-capture/capture-vi.c
@@ -1081,6 +1081,9 @@ int vi_capture_setup(
 
 cb_fail:
 resp_fail:
+	/* This setup never owned the id's callbacks: a later release must not
+	 * unregister them from the stream that does, nor unpin the freed list. */
+	capture->channel_id = CAPTURE_CHANNEL_INVALID_ID;
 submit_fail:
 	vfree(capture->unpins_list);
 	capture->unpins_list = NULL;
diff --git a/drivers/platform/tegra/rtcpu/capture-ivc.c b/drivers/platform/tegra/rtcpu/capture-ivc.c
index 8b44eac..c1dbfe6 100644
--- a/drivers/platform/tegra/rtcpu/capture-ivc.c
+++ b/drivers/platform/tegra/rtcpu/capture-ivc.c
@@ -6,6 +6,7 @@
 #include <linux/tegra-capture-ivc.h>
 
 #include <linux/completion.h>
+#include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/of.h>
@@ -326,6 +327,7 @@ EXPORT_SYMBOL(tegra_capture_ivc_register_control_cb);
 int tegra_capture_ivc_notify_chan_id(uint32_t chan_id, uint32_t trans_id)
 {
 	struct tegra_capture_ivc *civc;
+	int busy_retries = 20;
 
 	if (chan_id >= NUM_CAPTURE_CHANNELS) {
 		pr_warn("%s: invalid chan_id\n", __func__);
@@ -356,6 +358,14 @@ int tegra_capture_ivc_notify_chan_id(uint32_t chan_id, uint32_t trans_id)
 		return -EBADF;
 	}
 
+	/* RTCPU frees a channel id before its releaser unregisters the id's
+	 * callback, so a concurrent setup can be handed an id still in use here. */
+	while (civc->cb_ctx[chan_id].cb_func != NULL && busy_retries-- > 0) {
+		mutex_unlock(&civc->cb_ctx_lock);
+		usleep_range(1000, 2000);
+		mutex_lock(&civc->cb_ctx_lock);
+	}
+
 	if (civc->cb_ctx[chan_id].cb_func != NULL) {
 		pr_warn("%s: channel context at %u is busy\n", __func__, chan_id);
 		mutex_unlock(&civc->cb_ctx_lock);
-- 
2.54.0.windows.1

