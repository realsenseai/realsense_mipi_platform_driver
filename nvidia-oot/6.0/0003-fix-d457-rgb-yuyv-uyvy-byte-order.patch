From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GMSL Driver Developer <developer@example.com>
Date: Sun, 2 Mar 2026 12:00:00 +0000
Subject: [PATCH] Fix D457 RGB stream YUYV/UYVY byte order mismatch

D457 camera RGB stream outputs UYVY byte order data, but reports YUYV
format to maintain compatibility with USB mode and RealSense viewer.
This patch detects D4XX RGB streams by checking the subdev name and
applies the correct UYVY byte order (T_U8_Y8__V8_Y8) when reading data,
while still reporting YUYV fourcc to userspace.

This fix only affects D4XX RGB streams and does not impact other cameras.

Signed-off-by: GMSL Driver Developer <developer@example.com>
---
 drivers/media/platform/tegra/camera/vi/vi5_fops.c | 32 +++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
index 487ae44b..deadbeef 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -383,6 +383,26 @@ err_setup:
 	return 0;
 }
 
+/*
+ * Check if this is a D4XX RGB stream that needs YUV byte order swap.
+ * D457 RGB outputs UYVY byte order but reports YUYV for USB compatibility.
+ * Returns true if byte swap is needed.
+ */
+static bool vi5_is_d4xx_rgb_stream(struct tegra_channel *chan)
+{
+	struct v4l2_subdev *sd = chan->subdev_on_csi;
+
+	if (!sd || !sd->name)
+		return false;
+
+	/* Check if subdev name contains "D4XX" and "rgb" */
+	if (strstr(sd->name, "D4XX") && strstr(sd->name, "rgb"))
+		return true;
+
+	return false;
+}
+
+
 static void vi5_setup_surface(struct tegra_channel *chan,
 	struct tegra_channel_buffer *buf, unsigned int descr_index, unsigned int vi_port)
 {
@@ -400,6 +420,18 @@ static void vi5_setup_surface(struct tegra_channel *chan,
 		capture_data->requests_memoryinfo[descr_index];
 	struct capture_descriptor *desc = &chan->request[vi_port][descr_index];
 
+	/*
+	 * D4XX RGB stream workaround:
+	 * D457 outputs UYVY byte order but reports YUYV format for USB compatibility.
+	 * When D4XX RGB stream is detected and format is YUYV (T_Y8_U8__Y8_V8 = 16),
+	 * use UYVY image format (T_U8_Y8__V8_Y8 = 19) to correctly parse the data.
+	 */
+	if (format == TEGRA_IMAGE_FORMAT_T_Y8_U8__Y8_V8 && vi5_is_d4xx_rgb_stream(chan)) {
+		/* TEGRA_IMAGE_FORMAT_T_U8_Y8__V8_Y8 = 19 */
+		format = TEGRA_IMAGE_FORMAT_T_U8_Y8__V8_Y8;
+		dev_dbg(chan->vi->dev, "%s: D4XX RGB byte swap applied\n", __func__);
+	}
+
 	if (chan->valid_ports > NVCSI_STREAM_1) {
 		height = chan->gang_height;
 		width = chan->gang_width;
