+int max96712_set_pipe(struct device *dev, int pipe_id,
+		     u8 data_type1, u8 data_type2, u32 link, u32 vc_id)
+{
+	struct max96712 *priv = dev_get_drvdata(dev);
+	int err = 0;
+
+	if (pipe_id > (MAX96712_MAX_PIPES - 1)) {
+		dev_info(dev, "%s, input pipe_id: %d exceed max96712 max pipes\n",
+			 __func__, pipe_id);
+		return -EINVAL;
+	}
+
+	if (link >= MAX96712_MAX_LINKS || vc_id >= MAX96712_MAX_SER_VCS ||
+	    priv->vc_remap[link][vc_id] == MAX96712_VC_UNMAPPED) {
+		dev_err(dev, "%s: link %u serializer vc %u has no deserializer VC\n",
+			__func__, link, vc_id);
+		return -EINVAL;
+	}
+
+	dev_dbg(dev, "%s pipe_id %d, data_type1 %u, data_type2 %u, link %u, vc_id %u -> dser vc %u\n",
+		__func__, pipe_id, data_type1, data_type2, link, vc_id,
+		priv->vc_remap[link][vc_id]);
+
+	mutex_lock(&priv->lock);
+
+	if (max96712_pipe_is_multi_vc(priv, pipe_id)) {
+		/*
+		 * Multi-VC pipes carry all of the camera's virtual channels and
+		 * are configured exactly once. Later stream starts (and the
+		 * config-retry loop) reuse the existing mapping unchanged.
+		 */
+		if (!priv->multi_vc_configured[pipe_id]) {
+			err = __max96712_set_multi_vc_pipe(dev, pipe_id, link);
+			if (!err)
+				priv->multi_vc_configured[pipe_id] = true;
+		}
+		if (!err)
+			err = __max96712_update_multi_vc_pipe(dev, pipe_id, link, vc_id, data_type1);
+	} else {
+		err = __max96712_set_pipe(dev, pipe_id, data_type1, data_type2, link, vc_id);
+	}
+
+	mutex_unlock(&priv->lock);
+
+	return err;
+}
+EXPORT_SYMBOL(max96712_set_pipe);
+
+static int max96712_wait_for_link_lock_mask(struct device *dev, uint8_t link_mask)
+{
+	struct max96712 *priv = dev_get_drvdata(dev);
+	unsigned int reg_val = 0;
+	int err = 0;
+	int i;
+	int retry = 0;
+	int ready_link_mask = 0;
+
+	const u16 link_lock_reg_addr[MAX96712_MAX_LINKS] = {
+		MAX96712_LINK_A_LOCK_ADDR,
+		MAX96712_LINK_B_LOCK_ADDR,
+		MAX96712_LINK_C_LOCK_ADDR,
+		MAX96712_LINK_D_LOCK_ADDR
+	};
+
+	do {
+		if (retry != 0) {
+			msleep(MAX96712_LINK_UP_RETRY_DELAY_MS);
+		}
+		for (i = 0; i < MAX96712_MAX_LINKS; i++) {
+			if ((link_mask & (0x1 << i)) && !(ready_link_mask & (0x1 << i))) {
+				err = max96712_read_reg(priv, link_lock_reg_addr[i], &reg_val);
+				if (!err && (reg_val & MAX96712_LINK_LOCKED)) {
+					ready_link_mask |= 0x1 << i;
+				}
+			}
+		}
+		retry++;
+	} while (retry < MAX96712_LINK_UP_MAX_RETRIES && (ready_link_mask != link_mask));
+
+	if (ready_link_mask != link_mask) {
+		err = -ETIMEDOUT;
+	}
+	return err;
+}
+
+int max96712_setup_link(struct device *dev, struct device *s_dev)
+{
+	struct max96712 *priv = dev_get_drvdata(dev);
+	uint8_t link_mask = priv->link_mask;
+	unsigned int reg_val = 0;
+	unsigned int dser_empty_link_mask_reg = 0xF0;
+	uint8_t link_id_iter = 0;
+	unsigned default_ser_addr = MAX9295_DEFAULT_ADDR;
+	int err = 0;
+
+	/* Enable requested link mask to wait for link locks */
+	err = max96712_write_reg(priv, MAX96712_REG6_ADDR, dser_empty_link_mask_reg | link_mask);
+	if (err) {
+		dev_err(dev, "%s: Deserializer inaccessible\n", __func__);
+		return err;
+	}
+
+	err = max96712_wait_for_link_lock_mask(dev, link_mask);
+	if (err) {
+		dev_err(dev, "%s: Timeout wait for link lock\n", __func__);
+		return err;
+	}
+
+	/* Iterating over the links and assigning unique serializer i2c addresses */
+	for (link_id_iter = 0; link_id_iter < MAX96712_MAX_LINKS ; link_id_iter++)
+	{
+		if (link_mask & (1 << link_id_iter))
+		{
+			/* Camera should be connected on this link */
+			unsigned int dst_ser_addr = default_ser_addr + link_id_iter;
+			unsigned int curr_map = dser_empty_link_mask_reg | (1 << link_id_iter);
+
+			/* Enable single link */
+			max96712_write_reg(priv, MAX96712_REG6_ADDR, curr_map);
+			msleep(20);
+			max96712_reset_oneshot(dev);
+
+			err = max96712_read_slave_reg(priv, dst_ser_addr, 0, &reg_val);
+			if ((err == 0) && (reg_val == (dst_ser_addr << 1)))
+			{
+				dev_dbg(dev, "%s Serializer already at 0x%x\n", __func__, dst_ser_addr);
+				continue;
+			}
+
+			/* Assign the new i2c address */
+			max96712_write_slave_reg(priv, default_ser_addr, 0, dst_ser_addr << 1);
+		}
+	}
+	max96712_write_reg(priv, MAX96712_REG6_ADDR, dser_empty_link_mask_reg | link_mask);
+	return 0;
+}
+EXPORT_SYMBOL(max96712_setup_link);
+
+int max96712_setup_control(struct device *dev, struct device *s_dev)
+{
+	struct max96712 *priv = dev_get_drvdata(dev);
+	int err = 0;
+
+	mutex_lock(&priv->lock);
+
+	/* Configure ESYNC registers for GPIO tunneling */
+	/* MFP6 configuration for multi-deserializer sync */
+	err |= max96712_write_reg(priv, MAX96712_LINKA_MFP6_A_ADDR, MAX96712_LINKA_MFP_A_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKA_MFP6_B_ADDR, MAX96712_LINKA_MFP_B_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKB_MFP6_B_ADDR, MAX96712_LINKB_MFP_B_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKC_MFP6_B_ADDR, MAX96712_LINKC_MFP_B_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKD_MFP6_B_ADDR, MAX96712_LINKD_MFP_B_ESYNC);
+
+	/* MFP2 configuration for single-deserializer sync */
+	err |= max96712_write_reg(priv, MAX96712_LINKA_MFP2_A_ADDR, MAX96712_LINKA_MFP_A_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKA_MFP2_B_ADDR, MAX96712_LINKA_MFP_B_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKB_MFP2_B_ADDR, MAX96712_LINKB_MFP_B_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKC_MFP2_B_ADDR, MAX96712_LINKC_MFP_B_ESYNC);
+	err |= max96712_write_reg(priv, MAX96712_LINKD_MFP2_B_ADDR, MAX96712_LINKD_MFP_B_ESYNC);
+
+	mutex_unlock(&priv->lock);
+
+	return err;
+}
+EXPORT_SYMBOL(max96712_setup_control);
