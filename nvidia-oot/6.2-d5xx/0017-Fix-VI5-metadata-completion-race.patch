From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhou <shengyong.zhou@realsenseai.com>
Date: Wed, 12 Aug 2026 08:48:00 +0800
Subject: [PATCH] media: tegra: fix VI5 metadata completion ordering

Complete a metadata sidecar before publishing its paired video buffer.
Userspace may dequeue and requeue the video buffer immediately, resetting
the sequence value that the metadata completion path still needs.

Signed-off-by: zhou <shengyong.zhou@realsenseai.com>
---
 .../platform/tegra/camera/vi/vi5_fops.c      | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
index d1356ead..16f61927 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -561,10 +561,11 @@ static void vi5_release_buffer(struct tegra_channel *chan,
 	vbuf->field = V4L2_FIELD_NONE;
 	vb2_set_plane_payload(&vbuf->vb2_buf, 0, chan->format.sizeimage);
 
-	vb2_buffer_done(&vbuf->vb2_buf, buf->vb2_state);
-
+	/* Userspace may requeue vbuf as soon as it is published. */
 	if (chan->embedded_data_height == 1 && buf->vb2_state == VB2_BUF_STATE_DONE)
 		vi5_release_metadata_buffer(chan, vbuf);
+
+	vb2_buffer_done(&vbuf->vb2_buf, buf->vb2_state);
 }
 
 static void vi5_capture_enqueue(struct tegra_channel *chan,
-- 
