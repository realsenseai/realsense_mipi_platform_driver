From 6d929bd3a8e5253ff24e28afff40c4ace81ce94e Mon Sep 17 00:00:00 2001
From: ejgoldik <ehud.joseph.goldik@realsenseai.com>
Date: Thu, 18 Sep 2025 20:06:47 +0300
Subject: [PATCH] vi: channel: recover from capture timeout by restarting
 stream

When vi5 capture times out, attempt stream recovery by cycling s_stream
off/on across the registered subdevices. Subdevices are iterated in
reverse order so pipeline aggregators (e.g. mux subdevs that control the
full stream pipeline) are reached before individual sensor subdevs.

Signed-off-by: Ehud J. Goldik <ehud.joseph.goldik@realsenseai.com>
---
 .../media/platform/tegra/camera/vi/vi5_fops.c | 27 ++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
index b990c09f..c297def5 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -542,6 +542,26 @@ uncorr_err:
 	spin_unlock_irqrestore(&chan->capture_state_lock, flags);
 }

+static int vi5_attempt_restart_stream(struct tegra_channel *chan)
+{
+	int i, err = -ENODEV;
+
+	/*
+	 * Attempt recovery by cycling s_stream on the subdevice that controls
+	 * the camera stream pipeline. Iterate in reverse to try pipeline
+	 * aggregators (e.g. mux subdevs) before individual sensor subdevs.
+	 */
+	for (i = chan->num_subdevs - 1; i >= 0; i--) {
+		if (!chan->subdev[i] ||
+		    !v4l2_subdev_has_op(chan->subdev[i], video, s_stream))
+			continue;
+		err = v4l2_subdev_call(chan->subdev[i], video, s_stream, 0);
+		if (err && err != -ENOIOCTLCMD)
+			continue;
+		return v4l2_subdev_call(chan->subdev[i], video, s_stream, 1);
+	}
+	return err;
+}
+
 static void vi5_capture_dequeue(struct tegra_channel *chan,
 	struct tegra_channel_buffer *buf)
 {
@@ -575,8 +595,13 @@ static void vi5_capture_dequeue(struct tegra_channel *chan,
 					goto rel_buf;
 				} else {
 					dev_err(vi->dev,
-						"uncorr_err: request timed out after %d ms\n",
+						"uncorr_err: request timed out after %d ms - attempting restart\n",
 						timeout_ms);
+					err = vi5_attempt_restart_stream(chan);
+					if (err != 0) {
+						dev_err(vi->dev,
+							"uncorr_err: Restart failed\n");
+					}
 				}
 			} else {
 				dev_err(vi->dev, "uncorr_err: request err %d\n", err);
--
2.43.0

