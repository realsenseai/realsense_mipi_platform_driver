From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shengyong Zhou <shengyong.zhou@realsenseai.com>
Date: Tue, 1 Sep 2026 22:30:00 +0800
Subject: [PATCH] media: tegra: add generic VI resource VC alias hook

Let an endpoint use a separate VC value for the stock RCE setup resource
key while capture descriptors continue to match the endpoint's physical
wire VC.  Endpoints without the optional property retain stock behavior.

This is a setup-plane hook only.  It does not rewrite CSI packets, infer
source identity, or change per-request frame matching.

Signed-off-by: Shengyong Zhou <shengyong.zhou@realsenseai.com>
---
 drivers/media/platform/tegra/camera/vi/channel.c  | 14 ++++++++++++++
 drivers/media/platform/tegra/camera/vi/vi5_fops.c |  2 +-
 include/media/mc_common.h                         |  1 +
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/tegra/camera/vi/channel.c b/drivers/media/platform/tegra/camera/vi/channel.c
index c67c402b..0376c172 100644
--- a/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/drivers/media/platform/tegra/camera/vi/channel.c
@@ -2860,6 +2860,7 @@ int tegra_vi_get_port_info(struct tegra_channel *chan,
 
 			/* vc-id is optional, default is 0 */
 			chan->virtual_channel = (ret < 0) ? 0 : value;
+			chan->resource_virtual_channel = chan->virtual_channel;
 
 			/* Consider max simultaneous sensor streams to be 16 */
 			if (value > 16) {
@@ -2867,6 +2868,18 @@ int tegra_vi_get_port_info(struct tegra_channel *chan,
 				return -EINVAL;
 			}
 
+			ret = of_property_read_u32(ep,
+				"nvidia,vi-resource-vc-id", &value);
+			if (ret == 0) {
+				if (value >= 16U) {
+					dev_err(chan->vi->dev,
+						"VI resource vc id %u out of range\n",
+						value);
+					return -EINVAL;
+				}
+				chan->resource_virtual_channel = value;
+			}
+
 			/* Get CSI port */
 			ret = of_property_read_u32(ep, "port-index", &value);
 			if (ret < 0)
@@ -2953,6 +2966,7 @@ static int tegra_channel_csi_init(struct tegra_channel *chan)
 				% NUM_TPG_INSTANCE;
 		chan->virtual_channel =  (chan->id - vi->num_channels)
 				/ NUM_TPG_INSTANCE;
+		chan->resource_virtual_channel = chan->virtual_channel;
 
 		WARN_ON(chan->port[0] > vi->csi->num_tpg_channels);
 		chan->numlanes = 2;
diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
index 31e6697c..2a92a354 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -365,7 +365,7 @@ static int tegra_channel_capture_setup(struct tegra_channel *chan, unsigned int
 
 	/* Set the NVCSI PixelParser index (Stream ID) and VC ID*/
 	setup.csi_stream_id = chan->port[vi_port];
-	setup.virtual_channel_id = chan->virtual_channel;
+	setup.virtual_channel_id = chan->resource_virtual_channel;
 	/* Set CSI port info */
 	if (chan->pg_mode) {
 		setup.csi_port = NVCSI_PORT_UNSPECIFIED;
diff --git a/include/media/mc_common.h b/include/media/mc_common.h
index b2a20ffd..34a467a5 100644
--- a/include/media/mc_common.h
+++ b/include/media/mc_common.h
@@ -190,6 +190,7 @@ struct tegra_channel {
 	unsigned int vi_channel_id[TEGRA_CSI_BLOCKS];
 	unsigned char port[TEGRA_CSI_BLOCKS];
 	unsigned int virtual_channel;
+	unsigned int resource_virtual_channel;
 	unsigned int syncpt[TEGRA_CSI_BLOCKS][MAX_SYNCPT_PER_CHANNEL];
 	unsigned int syncpoint_fifo[TEGRA_CSI_BLOCKS][MAX_SYNCPT_PER_CHANNEL];
 	unsigned int buffer_offset[TEGRA_CSI_BLOCKS];
-- 
2.43.0
