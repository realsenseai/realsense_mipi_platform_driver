+DEFINE_SHOW_ATTRIBUTE(tegra_csi_debugfs_status);
+DEFINE_SHOW_ATTRIBUTE(tegra_csi_debugfs_routes);
+DEFINE_SHOW_ATTRIBUTE(tegra_csi_debugfs_formats);
