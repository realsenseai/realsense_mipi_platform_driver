+static const char *tegra_csi_debugfs_port_name(u32 port)
+{
+	switch (port) {
+	case NVCSI_PORT_A:
+		return "serial_a";
+	case NVCSI_PORT_B:
+		return "serial_b";
+	case NVCSI_PORT_C:
+		return "serial_c";
+	case NVCSI_PORT_D:
+		return "serial_d";
+	case NVCSI_PORT_E:
+		return "serial_e";
+	case NVCSI_PORT_F:
+		return "serial_f";
+	case NVCSI_PORT_G:
+		return "serial_g";
+	case NVCSI_PORT_H:
+		return "serial_h";
+	default:
+		return "unspecified";
+	}
+}
