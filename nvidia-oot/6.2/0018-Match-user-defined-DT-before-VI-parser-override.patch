From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhou <shengyong.zhou@realsenseai.com>
Date: Tue, 1 Sep 2026 20:02:00 +0800
Subject: [PATCH] media: tegra: preserve user-defined DT match with parser override

Keep the incoming user-defined CSI datatype in the VI channel match key
while overriding only the pixel parsing rule. This lets independent
same-VC payloads route to distinct VI queues by datatype without a payload
copy.

Apply the mechanism to the D5x ODPD proof of concept: match the physical
DT 0x32 carrier, then parse its byte surface with the RAW8 rule.

Signed-off-by: zhou <shengyong.zhou@realsenseai.com>
---
 drivers/media/platform/tegra/camera/vi/vi5_fops.c  | 10 ++++++----
 drivers/media/platform/tegra/camera/vi/vi5_formats.h | 6 ++++--
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -447,10 +447,12 @@ static void vi5_setup_surface(struct tegra_channel *chan,
 	/* Formats may declare a datatype override (tegra_camera_core.h) to
 	 * substitute the parsing rule for the incoming pixel packets.
-	 * DT matching must be disabled: dt_enable never matches a frame
-	 * with matching left on.
+	 * Standard carriers preserve the legacy match-disabled behavior;
+	 * user-defined carriers retain their physical DT for routing.
 	 */
 	if (chan->fmtinfo->dt_override) {
-		desc->ch_cfg.match.datatype = 0;
-		desc->ch_cfg.match.datatype_mask = 0;
+		if (chan->fmtinfo->img_dt < TEGRA_IMAGE_DT_USER_1) {
+			desc->ch_cfg.match.datatype = 0;
+			desc->ch_cfg.match.datatype_mask = 0;
+		}
 		desc->ch_cfg.dt_enable = 1;
 		desc->ch_cfg.dt_override = chan->fmtinfo->dt_override;
diff --git a/drivers/media/platform/tegra/camera/vi/vi5_formats.h b/drivers/media/platform/tegra/camera/vi/vi5_formats.h
--- a/drivers/media/platform/tegra/camera/vi/vi5_formats.h
+++ b/drivers/media/platform/tegra/camera/vi/vi5_formats.h
@@ -182,8 +182,10 @@ static const struct tegra_video_format vi5_video_formats[] = {
 	TEGRA_VIDEO_FORMAT_OVERRIDE(RAW8, 8, RS_NV12_FLAT_1X8, 1, 1, T_R8,
 				RAW8, NV12, "NV12 flat over RAW8",
 				0, 0, 1, 1, 3, 2),
-	TEGRA_VIDEO_FORMAT(RAW8, 8, D5X_ODPD_1X8, 1, 1, T_R8,
-				USER_3, ODPD, "D5x ODPD 8-bit DT0x32"),
+	TEGRA_VIDEO_FORMAT_OVERRIDE(RAW8, 8, D5X_ODPD_1X8, 1, 1, T_R8,
+				USER_3, ODPD, "D5x ODPD 8-bit DT0x32",
+				TEGRA_IMAGE_DT_RAW8,
+				TEGRA_IMAGE_FORMAT_T_R8, 1, 1, 1, 1),
 
 
 };
