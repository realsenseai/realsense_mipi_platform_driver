+struct reg_pair {
+	u16 addr;
+	u8 val;
+};
+
+static int max96712_set_registers(struct max96712 *priv, struct reg_pair *map, u32 count)
+{
+	int err = 0;
+	u32 j = 0;
+
+	for (j = 0; j < count; j++) {
+		err = max96712_write_reg(priv, map[j].addr, map[j].val);
+		if (err != 0)
+			break;
+	}
+
+	return err;
+}
+
+static int max96712_set_reverse_lane_polarity(struct max96712 *priv)
+{
+	struct reg_pair lane_polarity[] = {
+		/*
+		 * FG12-4CH routes the MAX96712 CSI-2 lanes with reversed polarity.
+		 */
+		{MAX96712_MIPI_PHY5_ADDR, 0x3f},
+		{MAX96712_MIPI_PHY6_ADDR, 0x3f},
+	};
+
+	return max96712_set_registers(priv, lane_polarity,
+				      ARRAY_SIZE(lane_polarity));
+}
+
+static int max96712_enable_poc(struct max96712 *priv)
+{
+	struct reg_pair poc_enable[] = {
+		{MAX96712_FANGZHU_POC_IO_ADDR, 0xe0},
+		{MAX96712_FANGZHU_FG12_POC_ADDR, 0x80},
+	};
+	int err;
+
+	err = max96712_set_registers(priv, poc_enable,
+				     ARRAY_SIZE(poc_enable));
+	if (err)
+		return err;
+
+	msleep(100);
+	err = max96712_write_reg(priv, MAX96712_FANGZHU_FG12_POC_ADDR, 0x90);
+	if (err)
+		return err;
+
+	msleep(500);
+
+	return 0;
+}
+
+int max96712_get_available_pipe_id(struct device *dev, int vc_id)
+{
+	int i;
+	int pipe_id = -ENOSR;
+	struct max96712 *priv = dev_get_drvdata(dev);
+
+	mutex_lock(&priv->lock);
+	for (i = 0; i < MAX96712_MAX_PIPES; i++) {
+		if (priv->video_pipe_alloc[i] == false) {
+			priv->video_pipe_alloc[i] = true;
+			pipe_id = i;
+			break;
+		}
+	}
+	mutex_unlock(&priv->lock);
+
+	return pipe_id;
+}
+EXPORT_SYMBOL(max96712_get_available_pipe_id);
+
+/* Caller must hold priv->lock. */
+static bool max96712_pipe_is_multi_vc(struct max96712 *priv, int pipe_id)
+{
+	int link;
+
+	for (link = 0; link < MAX96712_MAX_LINKS; link++)
+		if (priv->link_multi_vc_pipe[link] == pipe_id)
+			return true;
+
+	return false;
+}
+
+/*
+ * Allocate (or return the already-allocated) multi-VC pipe for the link that
+ * owns vc_id. Used for MAX96717 serializers, which route all of a camera's
+ * virtual channels through a single serializer pipe. The pipe is dedicated to
+ * the link for the driver's lifetime: every stream of that camera reuses it and
+ * max96712_release_pipe() never frees it.
+ */
+int max96712_get_multi_vc_pipe_id(struct device *dev, int vc_id)
+{
+	struct max96712 *priv = dev_get_drvdata(dev);
+	int link = vc_id / MAX9295_MAX_STREAMS;
+	int pipe_id = -ENOSR;
+	int i;
+
+	if (link < 0 || link >= MAX96712_MAX_LINKS)
+		return -EINVAL;
+
+	mutex_lock(&priv->lock);
+
+	if (priv->link_multi_vc_pipe[link] >= 0) {
+		/* This link already owns a multi-VC pipe: reuse it. */
+		pipe_id = priv->link_multi_vc_pipe[link];
+		goto out;
+	}
+
+	for (i = 0; i < MAX96712_MAX_PIPES; i++) {
+		if (priv->video_pipe_alloc[i] == false) {
+			priv->video_pipe_alloc[i] = true;
+			priv->link_multi_vc_pipe[link] = i;
+			pipe_id = i;
+			break;
+		}
+	}
+
+out:
+	mutex_unlock(&priv->lock);
+
+	return pipe_id;
+}
+EXPORT_SYMBOL(max96712_get_multi_vc_pipe_id);
