From 8205c63d4fc6b398240ccf49ad244570956343d0 Mon Sep 17 00:00:00 2001
From: ejgoldik <ehud.joseph.goldik@realsenseai.com>
Date: Sun, 30 Aug 2026 13:45:10 +0300
Subject: [PATCH] Export tegra_channel_refresh_fmts for runtime format-list
 changes

tegra_channel_fmts_bitmap_init() runs exactly once per channel, from
tegra_channel_init_subdevices() at subdev-bind time. VIDIOC_ENUM_FMT,
TRY_FMT and S_FMT on the video node consult only that snapshot, so a
sensor subdev whose enum_mbus_code list changes after probe keeps
advertising the stale set until the driver is re-probed.

Wrap the existing initialiser in an exported entry point so a sensor
driver can ask its channel to re-enumerate. The refresh also re-derives
chan->fmtinfo and chan->format, so it is refused with -EBUSY while the
channel is streaming or holds allocated buffers; a client that already
negotiated a format must not have it changed underneath it.

chan->video_lock also backs chan->video->lock and chan->queue.lock, so
the v4l2 ioctl core holds it for the duration of any ioctl on this
channel's node. Callers must therefore be off that path, or targeting a
different channel than the one whose ioctl they are servicing.
---
 .../media/platform/tegra/camera/vi/channel.c  | 24 +++++++++++++++++++
 include/media/mc_common.h                     |  1 +
 2 files changed, 25 insertions(+)

diff --git a/drivers/media/platform/tegra/camera/vi/channel.c b/drivers/media/platform/tegra/camera/vi/channel.c
index 8498ff034..29ce3d5fb 100644
--- a/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/drivers/media/platform/tegra/camera/vi/channel.c
@@ -380,6 +380,30 @@ static void tegra_channel_fmts_bitmap_init(struct tegra_channel *chan)
 		update_gang_mode(chan);
 }
 
+/* The bitmap is otherwise built once, at subdev bind, so a sensor whose format
+ * list varies at runtime (D58x device mode) keeps the stale set until reprobe.
+ * Caller must not hold this channel's video_lock - the v4l2 ioctl core does.
+ */
+int tegra_channel_refresh_fmts(struct tegra_channel *chan)
+{
+	int ret = 0;
+
+	if (!chan || !chan->subdev_on_csi)
+		return -EINVAL;
+
+	mutex_lock(&chan->video_lock);
+	/* Re-derives chan->format, so a client that already owns buffers must
+	 * not have its negotiated format changed underneath it. */
+	if (atomic_read(&chan->is_streaming) || vb2_is_busy(&chan->queue))
+		ret = -EBUSY;
+	else
+		tegra_channel_fmts_bitmap_init(chan);
+	mutex_unlock(&chan->video_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL(tegra_channel_refresh_fmts);
+
 /*
  * -----------------------------------------------------------------------------
  * Tegra channel frame setup and capture operations
diff --git a/include/media/mc_common.h b/include/media/mc_common.h
index d0e908bf1..01a9704f8 100644
--- a/include/media/mc_common.h
+++ b/include/media/mc_common.h
@@ -365,6 +365,7 @@ int tegra_vi_channels_init(struct tegra_mc_vi *vi);
 int tegra_channel_cleanup(struct tegra_channel *chan);
 int tegra_vi_channels_cleanup(struct tegra_mc_vi *vi);
 int tegra_channel_init_subdevices(struct tegra_channel *chan);
+int tegra_channel_refresh_fmts(struct tegra_channel *chan);
 void tegra_channel_remove_subdevices(struct tegra_channel *chan);
 struct v4l2_subdev *tegra_channel_find_linked_csi_subdev(
 	struct tegra_channel *chan);
-- 
