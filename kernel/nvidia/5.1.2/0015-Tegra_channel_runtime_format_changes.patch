From 1111111111111111111111111111111111111111 Mon Sep 17 00:00:00 2001
From: ejgoldik <ehud.joseph.goldik@realsenseai.com>
Date: Tue, 16 Sep 2026 12:00:00 +0300
Subject: [PATCH] Lazy VI format-bitmap refresh for runtime format lists

tegra_channel_fmts_bitmap_init() runs once per channel at subdev bind,
so a sensor whose enum_mbus_code list changes after probe (D58x
descriptor reload after a HW reset) keeps advertising the stale set
until re-probe.

Export tegra_channel_mark_fmts_dirty() for the sensor to flag the
change - a lock-free flag write, safe from a control handler already
holding the node's video_lock. The bitmap is rebuilt lazily on the next
format ioctl, which already runs under video_lock; deferring it there
avoids deadlocking the node against its own reset ioctl and makes the
first post-reset query see the fresh list. Skipped while streaming or
holding buffers, and the rebuild is bitmap-only - chan->format/fmtinfo
are saved and restored across it, so a client that negotiated a format
before REQBUFS never has it re-picked underneath a G_FMT/TRY_FMT
(tegra_channel_fmts_bitmap_init() otherwise re-selects fmtinfo
first-match by mbus code, which is lossy for formats sharing a code).

Signed-off-by: ejgoldik <ehud.joseph.goldik@realsenseai.com>
---
diff --git a/drivers/media/platform/tegra/camera/vi/channel.c b/drivers/media/platform/tegra/camera/vi/channel.c
--- a/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/drivers/media/platform/tegra/camera/vi/channel.c
@@ -386,6 +386,38 @@
 	if (chan->total_ports > 1)
 		update_gang_mode(chan);
 }
+
+/* Rebuild the bitmap on the ioctl thread, where the v4l2 core already holds
+ * video_lock (a rebuild from the marking context would deadlock the node
+ * against its own ioctl). Bitmap-only: the negotiated format is preserved.
+ */
+static void tegra_channel_refresh_fmts_locked(struct tegra_channel *chan)
+{
+	struct v4l2_pix_format format;
+	const struct tegra_video_format *fmtinfo;
+
+	if (!chan || !chan->subdev_on_csi || !READ_ONCE(chan->fmts_dirty))
+		return;
+	if (atomic_read(&chan->is_streaming) || vb2_is_busy(&chan->queue))
+		return;
+	/* Clear before the rebuild so a mark that races it is not lost. */
+	WRITE_ONCE(chan->fmts_dirty, false);
+	format = chan->format;
+	fmtinfo = chan->fmtinfo;
+	tegra_channel_fmts_bitmap_init(chan);
+	chan->format = format;
+	chan->fmtinfo = fmtinfo;
+}
+
+/* Lock-free stale mark for a sensor whose format list changes at runtime
+ * (D58x descriptor reload); the next format ioctl rebuilds the bitmap.
+ */
+void tegra_channel_mark_fmts_dirty(struct tegra_channel *chan)
+{
+	if (chan)
+		WRITE_ONCE(chan->fmts_dirty, true);
+}
+EXPORT_SYMBOL(tegra_channel_mark_fmts_dirty);
 
 /*
  * -----------------------------------------------------------------------------
@@ -1079,6 +1111,8 @@
 	struct v4l2_subdev_pad_config cfg = {};
 	int ret = 0;
 
+	tegra_channel_refresh_fmts_locked(chan);
+
 	/* Convert v4l2 pixel format (fourcc) into media bus format code */
 	fse.code = tegra_core_get_code_by_fourcc(chan, sizes->pixel_format, 0);
 	if (fse.code < 0)
@@ -1107,6 +1141,8 @@
 	struct v4l2_subdev_frame_interval_enum fie;
 	struct v4l2_subdev_pad_config cfg = {};
 	int ret = 0;
+
+	tegra_channel_refresh_fmts_locked(chan);
 
 	/* Convert v4l2 pixel format (fourcc) into media bus format code */
 	fie.code = tegra_core_get_code_by_fourcc(
@@ -1136,6 +1172,8 @@
 	struct tegra_channel *chan = video_drvdata(file);
 	unsigned int index = 0, i;
 	unsigned long *fmts_bitmap = chan->fmts_bitmap;
+
+	tegra_channel_refresh_fmts_locked(chan);
 
 	if (f->index >= bitmap_weight(fmts_bitmap, MAX_FORMAT_NUM))
 		return -EINVAL;
@@ -2056,6 +2094,8 @@
 	struct tegra_channel *chan = video_drvdata(file);
 	struct v4l2_pix_format *pix = &format->fmt.pix;
 
+	tegra_channel_refresh_fmts_locked(chan);
+
 	*pix = chan->format;
 
 	return 0;
@@ -2119,6 +2159,8 @@
 {
 	struct tegra_channel *chan = video_drvdata(file);
 
+	tegra_channel_refresh_fmts_locked(chan);
+
 	return  __tegra_channel_try_format(chan, &format->fmt.pix);
 }
 
@@ -2171,6 +2213,8 @@
 {
 	struct tegra_channel *chan = video_drvdata(file);
 	int ret = 0;
+
+	tegra_channel_refresh_fmts_locked(chan);
 
 	/* get the suppod format by try_fmt */
 	ret = __tegra_channel_try_format(chan, &format->fmt.pix);
diff --git a/include/media/mc_common.h b/include/media/mc_common.h
--- a/include/media/mc_common.h
+++ b/include/media/mc_common.h
@@ -250,6 +250,7 @@
 	} embedded;
 
 	DECLARE_BITMAP(fmts_bitmap, MAX_FORMAT_NUM);
+	bool fmts_dirty;		/* fmts_bitmap needs a runtime rebuild */
 	atomic_t power_on_refcnt;
 	struct v4l2_fh *fh;
 	bool bypass;
@@ -366,6 +367,7 @@
 int tegra_channel_cleanup(struct tegra_channel *chan);
 int tegra_vi_channels_cleanup(struct tegra_mc_vi *vi);
 int tegra_channel_init_subdevices(struct tegra_channel *chan);
+void tegra_channel_mark_fmts_dirty(struct tegra_channel *chan);
 void tegra_channel_remove_subdevices(struct tegra_channel *chan);
 struct v4l2_subdev *tegra_channel_find_linked_csi_subdev(
 	struct tegra_channel *chan);
