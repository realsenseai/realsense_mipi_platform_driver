From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ejgoldik <ehud.joseph.goldik@realsenseai.com>
Date: Sun, 31 Aug 2026 10:00:00 +0300
Subject: [PATCH] media: tegra: per-format VI transport geometry and datatype
 override

JP5 counterpart of nvidia-oot 0013. Let a format-table row declare a
datatype override and a transport geometry: the VI substitutes the row's
dt_override for the incoming pixel datatype (DT matching has to be off
for the override to take effect), pairs it with an explicit memory
writer, and scales the captured frame_x/frame_y and sizeimage by the
row's wire-geometry fractions, rounding frame_x up to the line padding
the transmitter applies. Both VI4 (Xavier) and VI5 carry it.

One row uses it: the D401 CSI-PT stream. It is packed 10-bit BGGR, 5
bytes per 4 pixels, that the VDF dword-aligns per line and sends over a
RAW8 carrier at one wire pixel per byte - bpp and frame_x_scale 5/4 with
frame_x_align 4, which gives 1288 px -> 1612 wire bytes and stays
correct at any width. The d4xx driver can then advertise, and hand the
FW, the true pixel width instead of the transport byte count.

Signed-off-by: ejgoldik <ehud.joseph.goldik@realsenseai.com>
---
 drivers/media/platform/tegra/camera/vi/channel.c   | 11 +++++
 drivers/media/platform/tegra/camera/vi/vi4_fops.c  | 26 +++++++++-
 .../media/platform/tegra/camera/vi/vi4_formats.h   |  7 +++
 drivers/media/platform/tegra/camera/vi/vi5_fops.c  | 23 +++++++++
 .../media/platform/tegra/camera/vi/vi5_formats.h   |  7 +++
 include/media/tegra_camera_core.h                  | 57 ++++++++++++++++++++++
 6 files changed, 129 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/tegra/camera/vi/channel.c b/drivers/media/platform/tegra/camera/vi/channel.c
index c2a9e6f14..fae8b3043 100644
--- a/drivers/media/platform/tegra/camera/vi/channel.c
+++ b/drivers/media/platform/tegra/camera/vi/channel.c
@@ -195,6 +195,9 @@ static void tegra_channel_fmt_align(struct tegra_channel *chan,
 	fmt_align = (denominator == 1) ? numerator : 1;
 	align = lcm(chan->width_align, fmt_align);
 	align = align > 0 ? align : 1;
+	/* Keep the stride at least as long as a padded wire line. */
+	if (vfmt->frame_x_align > 1)
+		align = lcm(align, (unsigned int)vfmt->frame_x_align);
 	bpl = tegra_core_bytes_per_line(*width, align, vfmt);
 
 	/* Align stride */
@@ -298,6 +301,10 @@ static void tegra_channel_update_format(struct tegra_channel *chan,
 
 	if (fourcc == V4L2_PIX_FMT_NV16)
 		chan->format.sizeimage *= 2;
+
+	/* Transport rows may exceed V4L2 rows (tegra_camera_core.h). */
+	chan->format.sizeimage = tegra_frac_scale(chan->format.sizeimage,
+					&chan->fmtinfo->frame_y_scale);
 }
 
 static void tegra_channel_fmts_bitmap_init(struct tegra_channel *chan)
@@ -2076,6 +2083,10 @@ __tegra_channel_try_format(struct tegra_channel *chan,
 	if (chan->fmtinfo->fourcc == V4L2_PIX_FMT_NV16)
 		pix->sizeimage *= 2;
 
+	/* Transport rows may exceed V4L2 rows (tegra_camera_core.h). */
+	pix->sizeimage = tegra_frac_scale(pix->sizeimage,
+					  &vfmt->frame_y_scale);
+
 	return ret;
 }
 
diff --git a/drivers/media/platform/tegra/camera/vi/vi4_fops.c b/drivers/media/platform/tegra/camera/vi/vi4_fops.c
index 9bae5563c..970c9048f 100644
--- a/drivers/media/platform/tegra/camera/vi/vi4_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi4_fops.c
@@ -454,6 +454,25 @@ static int tegra_channel_capture_setup(struct tegra_channel *chan,
 		width = chan->gang_width;
 	}
 
+	/* Rows may scale the transport geometry (tegra_camera_core.h):
+	 * the frame/crop/output extents count wire pixels and rows, which
+	 * can differ from the V4L2 geometry.
+	 */
+	width = tegra_frac_scale(width, &chan->fmtinfo->frame_x_scale);
+	if (chan->fmtinfo->frame_x_align > 1)
+		width = roundup(width, chan->fmtinfo->frame_x_align);
+	height = tegra_frac_scale(height, &chan->fmtinfo->frame_y_scale);
+
+	/* Formats may declare a datatype override (tegra_camera_core.h) to
+	 * substitute the parsing rule for the incoming pixel packets;
+	 * DT matching has to be off for the override to take effect.
+	 */
+	if (chan->fmtinfo->dt_override) {
+		data_type = 0;
+		if (chan->fmtinfo->pixfmt_override)
+			format = chan->fmtinfo->pixfmt_override;
+	}
+
 	err = tegra_channel_notify_enable(chan, index);
 	if (err < 0) {
 		dev_err(chan->vi->dev,
@@ -475,9 +494,12 @@ static int tegra_channel_capture_setup(struct tegra_channel *chan,
 
 	vi4_channel_write(chan, vnc_id, MATCH_DATATYPE,
 			((data_type << DATATYPE_SHIFT) & DATATYPE) |
-			DATATYPE_MASK);
+			(chan->fmtinfo->dt_override ? 0 : DATATYPE_MASK));
 
-	vi4_channel_write(chan, vnc_id, DT_OVERRIDE, 0x0);
+	vi4_channel_write(chan, vnc_id, DT_OVERRIDE,
+			chan->fmtinfo->dt_override ?
+			(((chan->fmtinfo->dt_override << 1) & OVRD_DT) |
+			 DT_OVRD_EN) : 0x0);
 
 	vi4_channel_write(chan, vnc_id, MATCH_FRAMEID,
 			((0 << FRAMEID_SHIFT) & FRAMEID) | 0);
diff --git a/drivers/media/platform/tegra/camera/vi/vi4_formats.h b/drivers/media/platform/tegra/camera/vi/vi4_formats.h
index 02d63ab62..3d1051748 100644
--- a/drivers/media/platform/tegra/camera/vi/vi4_formats.h
+++ b/drivers/media/platform/tegra/camera/vi/vi4_formats.h
@@ -156,6 +156,13 @@ static const struct tegra_video_format vi4_video_formats[] = {
 	TEGRA_VIDEO_FORMAT(RGB888, 24, RGB888_1X24, 4, 1, T_A8R8G8B8,
 				RGB888, Y12I, "Y12I 24"),
 
+	// D401 CSI-PT: packed 10-bit BGGR (5 bytes per 4 pixels) that the VDF
+	// dword-aligns per line, carried as RAW8 - one wire pixel per byte, so
+	// the same 5/4 and 4-byte padding give both bytesperline and frame_x.
+	TEGRA_VIDEO_FORMAT_OVERRIDE(RAW8, 8, RS_SBGGR10P_1X8, 5, 4, T_L8,
+				RAW8, SBGGR10P, "BGGR10P dword-aligned",
+				0, 0, 5, 4, 1, 1, 4),
+
 
 };
 
diff --git a/drivers/media/platform/tegra/camera/vi/vi5_fops.c b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
index 3a1bd53aa..1e1f91347 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_fops.c
+++ b/drivers/media/platform/tegra/camera/vi/vi5_fops.c
@@ -339,6 +339,15 @@ static void vi5_setup_surface(struct tegra_channel *chan,
 		offset = buf->addr + chan->buffer_offset[1 - vi_port];
 	}
 
+	/* Rows may scale the transport geometry (tegra_camera_core.h):
+	 * frame_x/frame_y count wire pixels/rows, which can differ from the
+	 * V4L2 geometry (e.g. Y16I: 32bpp pixels on a 16bpp RAW16 wire).
+	 */
+	width = tegra_frac_scale(width, &chan->fmtinfo->frame_x_scale);
+	if (chan->fmtinfo->frame_x_align > 1)
+		width = roundup(width, chan->fmtinfo->frame_x_align);
+	height = tegra_frac_scale(height, &chan->fmtinfo->frame_y_scale);
+
 	memcpy(desc, &capture_template, sizeof(capture_template));
 	memset(desc_memoryinfo, 0, sizeof(*desc_memoryinfo));
 
@@ -352,6 +361,20 @@ static void vi5_setup_surface(struct tegra_channel *chan,
 	desc->ch_cfg.pixfmt_enable = 1;
 	desc->ch_cfg.pixfmt.format = format;
 
+	/* Formats may declare a datatype override (tegra_camera_core.h) to
+	 * substitute the parsing rule for the incoming pixel packets.
+	 * DT matching must be disabled: dt_enable never matches a frame
+	 * with matching left on.
+	 */
+	if (chan->fmtinfo->dt_override) {
+		desc->ch_cfg.match.datatype = 0;
+		desc->ch_cfg.match.datatype_mask = 0;
+		desc->ch_cfg.dt_enable = 1;
+		desc->ch_cfg.dt_override = chan->fmtinfo->dt_override;
+		if (chan->fmtinfo->pixfmt_override)
+			desc->ch_cfg.pixfmt.format = chan->fmtinfo->pixfmt_override;
+	}
+
 	desc_memoryinfo->surface[0].base_address = offset;
 	desc_memoryinfo->surface[0].size = chan->format.bytesperline * height;
 	desc->ch_cfg.atomp.surface_stride[0] = bpl;
diff --git a/drivers/media/platform/tegra/camera/vi/vi5_formats.h b/drivers/media/platform/tegra/camera/vi/vi5_formats.h
index e59413b04..80551b449 100644
--- a/drivers/media/platform/tegra/camera/vi/vi5_formats.h
+++ b/drivers/media/platform/tegra/camera/vi/vi5_formats.h
@@ -155,6 +155,13 @@ static const struct tegra_video_format vi5_video_formats[] = {
 	TEGRA_VIDEO_FORMAT(RGB888, 24, RGB888_1X24, 4, 1, T_A8R8G8B8,
 				RGB888, Y12I, "Y12I 24"),
 
+	// D401 CSI-PT: packed 10-bit BGGR (5 bytes per 4 pixels) that the VDF
+	// dword-aligns per line, carried as RAW8 - one wire pixel per byte, so
+	// the same 5/4 and 4-byte padding give both bytesperline and frame_x.
+	TEGRA_VIDEO_FORMAT_OVERRIDE(RAW8, 8, RS_SBGGR10P_1X8, 5, 4, T_R8,
+				RAW8, SBGGR10P, "BGGR10P dword-aligned",
+				0, 0, 5, 4, 1, 1, 4),
+
 };
 
 #endif
diff --git a/include/media/tegra_camera_core.h b/include/media/tegra_camera_core.h
index 67221b0c6..35a418009 100644
--- a/include/media/tegra_camera_core.h
+++ b/include/media/tegra_camera_core.h
@@ -97,6 +97,24 @@ struct tegra_frac {
 	unsigned int denominator;
 };
 
+/**
+ * tegra_frac_scale - scale a transport dimension by a wire-geometry fraction
+ * @value: the V4L2-side dimension, in pixels, rows or bytes
+ * @f: the format row's fraction
+ *
+ * Multiplies before dividing so the ratio does not truncate. An unset
+ * fraction (zero numerator or denominator) and an identity ratio are both
+ * no-ops, so a zero denominator can never reach the division.
+ */
+static inline u32 tegra_frac_scale(u32 value, const struct tegra_frac *f)
+{
+	if (!f->numerator || !f->denominator ||
+	    f->numerator == f->denominator)
+		return value;
+
+	return (value * f->numerator) / f->denominator;
+}
+
 /**
  * struct tegra_video_format - Tegra video format description
  * @vf_code: video format code
@@ -107,6 +125,19 @@ struct tegra_frac {
  * @img_dt: image data type
  * @fourcc: V4L2 pixel format FCC identifier
  * @description: format description, suitable for userspace
+ * @dt_override: if nonzero, capture with CSI DT matching disabled and this
+ *		datatype substituted for the incoming pixel datatype
+ * @pixfmt_override: VI memory format paired with @dt_override (0 = keep
+ *		@img_fmt)
+ * @frame_x_scale: wire pixels per V4L2 pixel as a fraction; scales the
+ *		captured frame_x (zero numerator or denominator = no scaling)
+ * @frame_y_scale: transport rows per V4L2 row as a fraction; scales the
+ *		captured frame_y and surface size (zero numerator or
+ *		denominator = no scaling)
+ * @frame_x_align: granularity the transmitter pads each line up to, in wire
+ *		pixels; 0 and 1 both mean unpadded, being roundup no-ops.
+ *		The scaled frame_x rounds up to it, and it is folded into
+ *		the bytes-per-line alignment so the stride covers the line
  */
 struct tegra_video_format {
 	enum tegra_vf_code vf_code;
@@ -117,6 +148,11 @@ struct tegra_video_format {
 	enum tegra_image_dt img_dt;
 	u32 fourcc;
 	__u8 description[32];
+	u8 dt_override;
+	u8 pixfmt_override;
+	struct tegra_frac frame_x_scale;
+	struct tegra_frac frame_y_scale;
+	u8 frame_x_align;
 };
 
 #define	TEGRA_VIDEO_FORMAT(VF_CODE, BPP, MBUS_CODE, FRAC_BPP_NUM,	\
@@ -132,6 +168,27 @@ struct tegra_video_format {
 	DESCRIPTION,							\
 }
 
+#define	TEGRA_VIDEO_FORMAT_OVERRIDE(VF_CODE, BPP, MBUS_CODE,		\
+	FRAC_BPP_NUM, FRAC_BPP_DEN, FORMAT, DATA_TYPE, FOURCC,		\
+	DESCRIPTION, DT_OVERRIDE, PIXFMT_OVERRIDE,			\
+	FRAME_X_NUM, FRAME_X_DEN, FRAME_Y_NUM, FRAME_Y_DEN,		\
+	FRAME_X_ALIGN)							\
+{									\
+	TEGRA_VF_##VF_CODE,						\
+	BPP,								\
+	MEDIA_BUS_FMT_##MBUS_CODE,					\
+	{FRAC_BPP_NUM, FRAC_BPP_DEN},					\
+	TEGRA_IMAGE_FORMAT_##FORMAT,					\
+	TEGRA_IMAGE_DT_##DATA_TYPE,					\
+	V4L2_PIX_FMT_##FOURCC,						\
+	DESCRIPTION,							\
+	DT_OVERRIDE,							\
+	PIXFMT_OVERRIDE,						\
+	{FRAME_X_NUM, FRAME_X_DEN},					\
+	{FRAME_Y_NUM, FRAME_Y_DEN},					\
+	FRAME_X_ALIGN,							\
+}
+
 u32 tegra_core_get_word_count(unsigned int frame_width,
 		const struct tegra_video_format *fmt);
 u32 tegra_core_bytes_per_line(unsigned int width, unsigned int align,
-- 
2.43.0
