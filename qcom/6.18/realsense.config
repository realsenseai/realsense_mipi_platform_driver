# Kernel config fragment for the RealSense D4XX Qualcomm build (RSDEV-15171).
# Merged over the arm64 defconfig by build_all_qcom.sh.

# camss and the camera I2C controller. Both are already modules in the arm64
# defconfig; stated here so a defconfig change cannot quietly drop them.
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
