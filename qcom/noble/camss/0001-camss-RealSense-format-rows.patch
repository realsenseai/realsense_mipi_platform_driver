+++ b/camss-vfe.c
@@ -167,6 +167,27 @@ static const struct camss_format_info fo
 	  PER_PLANE_DATA(0, 1, 1, 1, 1, 10) },
 	{ MEDIA_BUS_FMT_Y10_2X8_PADHI_LE, 16, V4L2_PIX_FMT_Y10, 1,
 	  PER_PLANE_DATA(0, 1, 1, 1, 1, 16) },
+	/* RealSense. Rows sharing a media-bus code are told apart by the
