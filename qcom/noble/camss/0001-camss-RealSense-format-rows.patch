+	{ MEDIA_BUS_FMT_RGB888_1X24, 24, V4L2_PIX_FMT_Y12I, 1,
+	  PER_PLANE_DATA(0, 1, 1, 1, 1, 24) },
+	{ MEDIA_BUS_FMT_ARGB8888_1X32, 32, V4L2_PIX_FMT_Y16I, 1,
+	  PER_PLANE_DATA(0, 1, 1, 1, 1, 32) },
+	{ MEDIA_BUS_FMT_SGRBG16_1X16, 16, V4L2_PIX_FMT_SGRBG16, 1,
+	  PER_PLANE_DATA(0, 1, 1, 1, 1, 16) },
+	{ MEDIA_BUS_FMT_RS_NV12_FLAT_1X8, 8, V4L2_PIX_FMT_NV12, 1,
