 /*
+ * vfe_line_has_meta - Whether an RDI line has a metadata node
+ * @vfe: VFE device
+ * @line: VFE line
+ *
+ * Only where the hardware file takes its buffers from either node of a line.
+ */
+static bool vfe_line_has_meta(struct vfe_device *vfe, struct vfe_line *line)
+{
+	return vfe->res->hw_ops == &vfe_ops_170 && line->id != VFE_LINE_PIX;
+}
+
+/*
+ * vfe_line_video - The video node a line is linked to
+ * @line: VFE line
+ *
+ * Return the metadata node when its link is the enabled one, else the image node
+ */
+static struct camss_video *vfe_line_video(struct vfe_line *line)
+{
+	struct media_pad *pad;
+
+	pad = media_pad_remote_pad_first(&line->pads[MSM_VFE_PAD_SRC]);
+	if (pad && pad->entity == &line->video_meta.vdev.entity)
+		return &line->video_meta;
+
+	return &line->video_out;
+}
