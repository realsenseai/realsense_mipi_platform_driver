+/*
+ * video_meta_fmt - The format of a metadata node
+ * @video: struct camss_video
+ * @fmt: Return the format here, in its multi-planar form
+ *
+ * There is one data format, and a buffer holds the lines of the subdev the
+ * node is linked to; until it is linked, the size last set stands.
+ */
+static void video_meta_fmt(struct camss_video *video, struct v4l2_format *fmt)
+{
+	const struct v4l2_pix_format_mplane *cur = &video->active_fmt.fmt.pix_mp;
+
+	memset(fmt, 0, sizeof(*fmt));
+	fmt->fmt.pix_mp.pixelformat = video->formats[0].pixelformat;
+	if (!video_get_subdev_format(video, fmt))
+		return;
+
+	memset(fmt, 0, sizeof(*fmt));
+	fmt->fmt.pix_mp.pixelformat = video->formats[0].pixelformat;
+	fmt->fmt.pix_mp.width = cur->width;
+	fmt->fmt.pix_mp.height = cur->height;
+	__video_try_fmt(video, fmt);
+}
+
+static void video_meta_fill(const struct v4l2_format *fmt, struct v4l2_format *f)
+{
+	f->fmt.meta.dataformat = fmt->fmt.pix_mp.pixelformat;
+	f->fmt.meta.buffersize = fmt->fmt.pix_mp.plane_fmt[0].sizeimage;
+}
+
+static int video_enum_fmt_meta(struct file *file, void *fh,
+			       struct v4l2_fmtdesc *f)
+{
+	struct camss_video *video = video_drvdata(file);
+
+	if (f->index >= video->nformats)
+		return -EINVAL;
+
+	f->pixelformat = video->formats[f->index].pixelformat;
+
+	return 0;
+}
+
+static int video_g_fmt_meta(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct camss_video *video = video_drvdata(file);
+
+	video_meta_fill(&video->active_fmt, f);
+
+	return 0;
+}
+
+static int video_try_fmt_meta(struct file *file, void *fh,
+			      struct v4l2_format *f)
+{
+	struct camss_video *video = video_drvdata(file);
+	struct v4l2_format fmt;
+
+	video_meta_fmt(video, &fmt);
+	video_meta_fill(&fmt, f);
+
+	return 0;
+}
+
+static int video_s_fmt_meta(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct camss_video *video = video_drvdata(file);
+	struct v4l2_format fmt;
+
+	if (vb2_is_busy(&video->vb2_q))
+		return -EBUSY;
+
+	/* Through a copy: the size last set is read from the active format */
+	video_meta_fmt(video, &fmt);
+	video->active_fmt = fmt;
+	video_meta_fill(&fmt, f);
+
+	return 0;
+}
