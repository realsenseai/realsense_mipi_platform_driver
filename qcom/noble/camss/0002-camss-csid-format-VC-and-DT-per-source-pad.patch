+/*
+ * camss_find_sensor - Find a linked media entity which represents a sensor
+ * @entity: Media entity to start searching from
+ *
+ * Return a pointer to sensor media entity or NULL if not found
+ */
+struct media_entity *camss_find_sensor(struct media_entity *entity)
+{
+	struct media_pad *pad = camss_find_sensor_pad(entity);
+
+	return pad ? pad->entity : NULL;
+}
+
+/*
+ * camss_get_frame_desc - Get the CSI-2 frame descriptor of the linked sensor
+ * @entity: Media entity in the current pipeline
+ * @fd: Return the frame descriptor here
+ *
+ * Return 0 on success or a negative error code when the sensor is missing or
+ * does not describe its streams
+ */
+int camss_get_frame_desc(struct media_entity *entity,
+			 struct v4l2_mbus_frame_desc *fd)
+{
+	struct media_pad *pad = camss_find_sensor_pad(entity);
+	int ret;
+
+	if (!pad)
+		return -ENODEV;
+
+	ret = v4l2_subdev_call(media_entity_to_v4l2_subdev(pad->entity), pad,
+			       get_frame_desc, pad->index, fd);
+	if (ret)
+		return ret;
+
+	return fd->type == V4L2_MBUS_FRAME_DESC_TYPE_CSI2 ? 0 : -EINVAL;
+}
+
