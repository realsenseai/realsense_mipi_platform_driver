 /*
+ * csid_route_rdi - Resolve what an RDI captures
+ * @csid: CSID device
+ * @rdi: RDI, behind source pad MSM_CSID_PAD_FIRST_SRC + @rdi
+ *
+ * The RDI takes the virtual channel and data type of its stream from the
+ * sensor's frame descriptor. A sensor without one is a single stream on
+ * virtual channel @rdi, in the data type of the pad's format.
+ *
+ * Return 0 on success or a negative error code otherwise
+ */
+static int csid_route_rdi(struct csid_device *csid, u8 rdi)
+{
+	struct csid_rdi_route *route = &csid->route[rdi];
+	const struct csid_format_info *format;
+	struct v4l2_mbus_frame_desc fd;
+	bool found = false;
+	unsigned int i;
+
+	format = csid_get_fmt_entry(csid->res->formats->formats,
+				    csid->res->formats->nformats,
+				    csid->fmt[MSM_CSID_PAD_FIRST_SRC + rdi].code);
+
+	route->stream = v4l2_ctrl_g_ctrl(csid->rdi_stream[rdi]);
+	route->vc = rdi;
+	route->dt = format->data_type;
+	csid->phy.max_vc = max(csid->phy.max_vc, route->vc);
+
+	if (!csid->testgen.enabled &&
+	    !camss_get_frame_desc(&csid->subdev.entity, &fd)) {
+		for (i = 0; i < fd.num_entries; i++) {
+			const struct v4l2_mbus_frame_desc_entry *entry =
+				&fd.entry[i];
+
+			/* The receiver's VC mode is shared by all of its RDIs */
+			csid->phy.max_vc = max(csid->phy.max_vc,
+					       entry->bus.csi2.vc);
+
+			if (entry->stream != route->stream)
+				continue;
+
+			route->vc = entry->bus.csi2.vc;
+			route->dt = entry->bus.csi2.dt;
+			found = true;
+		}
+
+		if (!found) {
+			dev_err(csid->camss->dev,
+				"CSID%u RDI%u: the sensor has no stream %u\n",
+				csid->id, rdi, route->stream);
+			return -EINVAL;
+		}
+	}
+
+	dev_dbg(csid->camss->dev,
+		"CSID%u RDI%u: stream %u, VC %u, DT 0x%02x%s\n",
+		csid->id, rdi, route->stream, route->vc, route->dt,
+		found ? "" : " (no frame descriptor)");
+
+	return 0;
+}
