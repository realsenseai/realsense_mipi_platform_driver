+static int csid_configure_all(struct csid_device *csid, int enable)
+{
+	int ret;
+	u8 i;
+
+	if (!csid->phy.need_vc_update)
+		return 0;
+
+	for (i = 0; enable && i < MSM_CSID_MAX_SRC_STREAMS; i++) {
+		if (!(csid->phy.en_vc & BIT(i)))
+			continue;
+
+		ret = csid_route_rdi(csid, i);
+		if (ret < 0)
+			return ret;
+	}
+
+	csid->res->hw_ops->configure_stream(csid, enable);
+	csid->phy.need_vc_update = false;
+
+	return 0;
