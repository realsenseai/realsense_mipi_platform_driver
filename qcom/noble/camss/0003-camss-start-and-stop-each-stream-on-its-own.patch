+/*
+ * csiphy_sensor_stream - Start or stop one stream of the linked sensor
+ * @csiphy: CSIPHY device
+ * @stream: Sensor stream
+ * @enable: Requested streaming state
+ *
+ * A sensor with the streams API takes each stream on its own. Any other is
+ * one stream, started for its first user and stopped after its last; the
+ * caller counts the users, this one excluded.
+ *
+ * Return 0 on success or a negative error code otherwise
+ */
+static int csiphy_sensor_stream(struct csiphy_device *csiphy, u32 stream,
+				int enable)
+{
+	struct media_pad *pad;
+	struct v4l2_subdev *sd;
+	int ret;
+
+	pad = media_pad_remote_pad_first(&csiphy->pads[MSM_CSIPHY_PAD_SINK]);
+	if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+		return 0;
+
+	sd = media_entity_to_v4l2_subdev(pad->entity);
+
+	/* The core helpers need the routing an active state holds */
+	if ((sd->flags & V4L2_SUBDEV_FL_STREAMS) && sd->active_state &&
+	    sd->ops->pad && sd->ops->pad->enable_streams) {
+		if (enable)
+			return v4l2_subdev_enable_streams(sd, pad->index,
+							  BIT_ULL(stream));
+
+		return v4l2_subdev_disable_streams(sd, pad->index,
+						   BIT_ULL(stream));
+	}
+
+	if (csiphy->stream_count)
+		return 0;
+
+	ret = v4l2_subdev_call(sd, video, s_stream, enable);
+
+	return ret == -ENOIOCTLCMD ? 0 : ret;
+}
 
