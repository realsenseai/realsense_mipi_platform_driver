+/*
+ * video_stream_ctrl_handler - The control handler of one sensor stream
+ * @sd: Sensor V4L2 subdevice
+ * @pad: Source pad of the sensor
+ * @stream: Stream on that pad
+ *
+ * A sensor with the streams API routes each stream from a sink pad; the
+ * controls are those of the subdev feeding that pad, or the sensor's own when
+ * nothing does. Any other sensor is one stream with one set of controls.
+ *
+ * Return the handler, or NULL when there is none or the stream is not routed
+ */
+static struct v4l2_ctrl_handler *
+video_stream_ctrl_handler(struct v4l2_subdev *sd, u32 pad, u32 stream)
+{
+	struct v4l2_subdev_state *state;
+	struct media_pad *remote;
+	u32 sink_pad, sink_stream;
+	int ret;
+
+	if (!(sd->flags & V4L2_SUBDEV_FL_STREAMS) || !sd->active_state)
+		return sd->ctrl_handler;
+
+	state = v4l2_subdev_lock_and_get_active_state(sd);
+	ret = v4l2_subdev_routing_find_opposite_end(&state->routing, pad, stream,
+						    &sink_pad, &sink_stream);
+	v4l2_subdev_unlock_state(state);
+	if (ret)
+		return NULL;
+
+	remote = media_pad_remote_pad_first(&sd->entity.pads[sink_pad]);
+	if (!remote || !is_media_entity_v4l2_subdev(remote->entity))
+		return sd->ctrl_handler;
+
+	return media_entity_to_v4l2_subdev(remote->entity)->ctrl_handler;
+}
+
+/*
+ * video_update_ctrls - Take the controls of the stream the node captures
+ * @video: struct camss_video
+ *
+ * Follows the media graph as it is now, so it runs when the node is opened
+ * with no other handle on it: nothing then refers to the old controls.
+ */
+static void video_update_ctrls(struct camss_video *video)
+{
+	struct media_entity *entity = &video->vdev.entity;
+	struct v4l2_ctrl_handler *sensor_hdl;
+	struct media_pad *source = NULL;
+	struct v4l2_subdev *subdev;
+	struct media_pad *pad;
+	u32 stream = 0;
+	int ret;
+
+	v4l2_ctrl_handler_free(&video->ctrl_handler);
+	v4l2_ctrl_handler_init(&video->ctrl_handler, 16);
+
+	while (1) {
+		pad = &entity->pads[0];
+		if (!(pad->flags & MEDIA_PAD_FL_SINK))
+			break;
+
+		source = media_pad_remote_pad_first(pad);
+		if (!source || !is_media_entity_v4l2_subdev(source->entity))
+			return;
+
+		entity = source->entity;
+		subdev = media_entity_to_v4l2_subdev(entity);
+
+		if (subdev->grp_id == CAMSS_GRP_ID_CSID)
+			stream = msm_csid_pad_stream(subdev, source->index);
+	}
+
+	/* The walk ends on a sensor only when the graph reaches one */
+	if (!source || entity->function != MEDIA_ENT_F_CAM_SENSOR)
+		return;
+
+	sensor_hdl = video_stream_ctrl_handler(media_entity_to_v4l2_subdev(entity),
+					       source->index, stream);
+	if (!sensor_hdl)
+		return;
+
+	ret = v4l2_ctrl_add_handler(&video->ctrl_handler, sensor_hdl, NULL, true);
+	if (ret < 0)
+		dev_err(video->camss->dev,
+			"Failed to take the controls of %s: %d\n",
+			entity->name, ret);
+}
+
