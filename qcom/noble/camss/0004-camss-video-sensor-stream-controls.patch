 	file->private_data = NULL;
@@ -677,6 +779,8 @@ static void msm_video_release(struct vid
 
 	media_entity_cleanup(&vdev->entity);
 
+	v4l2_ctrl_handler_free(&video->ctrl_handler);
+
 	mutex_destroy(&video->q_lock);
 	mutex_destroy(&video->lock);
 
@@ -769,6 +873,9 @@ int msm_video_register(struct camss_vide
 		goto error_video_register;
 	}
 
+	/* Filled when the node is opened, from the sensor stream it is linked to */
+	v4l2_ctrl_handler_init(&video->ctrl_handler, 16);
+
 	vdev->fops = &msm_vid_fops;
 	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE_MPLANE | V4L2_CAP_STREAMING
 			  | V4L2_CAP_READWRITE | V4L2_CAP_IO_MC;
@@ -778,6 +885,7 @@ int msm_video_register(struct camss_vide
 	vdev->vfl_dir = VFL_DIR_RX;
 	vdev->queue = &video->vb2_q;
 	vdev->lock = &video->lock;
+	vdev->ctrl_handler = &video->ctrl_handler;
 	strscpy(vdev->name, name, sizeof(vdev->name));
 
 	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
@@ -793,6 +901,7 @@ int msm_video_register(struct camss_vide
 	return 0;
 
 error_video_register:
+	v4l2_ctrl_handler_free(&video->ctrl_handler);
 	media_entity_cleanup(&vdev->entity);
 	mutex_destroy(&video->lock);
