/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>

/* One D4xx/D457 camera on cam0 (deserializer 0, link 0).
 * This overlay does not configure TSC frame synchronization.
 */
#define CAM12V_POC	TEGRA234_MAIN_GPIO(AC, 7)
#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

#define CAM1_PWDN	TEGRA234_MAIN_GPIO(H, 3) /* deserializer on mux i2c@0 */

/ {
	overlay-name = "Orin FG12-12ch D4xx cam0";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment@1 {
		target-path = "/";
		__overlay__ {
			vdd_cam12v_poc: regulator-vdd-cam12v-poc {
				compatible = "regulator-fixed";
				regulator-name = "vdd-cam12v-poc";
				regulator-min-microvolt = <12000000>;
				regulator-max-microvolt = <12000000>;
				gpio = <&gpio CAM12V_POC GPIO_ACTIVE_HIGH>;
				enable-active-high;
			};
		};
	};

	fragment@0 {
		status = "okay";
		target-path = "/";
		__overlay__ {
			status = "okay";
			tegra-capture-vi {
				status = "okay";
				num-channels = <4>;
				ports {
					status = "okay";
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						status = "okay";
						reg = <0>;
						d4xx_vi_in0: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out0>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
						d4xx_vi_in1: endpoint {
							status = "okay";
							vc-id = <1>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out1>;
						};
					};
					port@2 {
						status = "okay";
						reg = <2>;
						d4xx_vi_in2: endpoint {
							status = "okay";
							vc-id = <2>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out2>;
						};
					};
					port@3 {
						status = "okay";
						reg = <3>;
						d4xx_vi_in3: endpoint {
							status = "okay";
							vc-id = <3>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out3>;
						};
					};
				};
			};

			bus@0 {
				status = "okay";
				host1x@13e00000 {
					status = "okay";
					nvcsi@15a00000 {
						status = "okay";
						num-channels = <4>;
						#address-cells = <1>;
						#size-cells = <0>;
						channel@0 {
							status = "okay";
							reg = <0>;
							ports {
								status = "okay";
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in0: endpoint@0 {
										status = "okay";
										port-index = <4>;
										bus-width = <4>;
										remote-endpoint = <&ds5_0_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out0: endpoint@1 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in0>;
									};
								};
							};
						};
						channel@1 {
							status = "okay";
							reg = <1>;
							ports {
								status = "okay";
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in1: endpoint@2 {
										status = "okay";
										port-index = <4>;
										bus-width = <4>;
										remote-endpoint = <&ds5_1_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out1: endpoint@3 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in1>;
									};
								};
							};
						};
						channel@2 {
							status = "okay";
							reg = <2>;
							ports {
								status = "okay";
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in2: endpoint@4 {
										status = "okay";
										port-index = <4>;
										bus-width = <4>;
										remote-endpoint = <&ds5_2_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out2: endpoint@5 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in2>;
									};
								};
							};
						};
						channel@3 {
							status = "okay";
							reg = <3>;
							ports {
								status = "okay";
								port@0 {
									status = "okay";
									reg = <0>;
									d4xx_csi_in3: endpoint@6 {
										status = "okay";
										port-index = <4>;
										bus-width = <4>;
										remote-endpoint = <&ds5_3_out>;
									};
								};
								port@1 {
									status = "okay";
									reg = <1>;
									d4xx_csi_out3: endpoint@7 {
										status = "okay";
										remote-endpoint = <&d4xx_vi_in3>;
									};
								};
							};
						};
					};
				};
				i2c@3180000 {
					status = "okay";
					clock-frequency = <100000>;
					tca9546@70 {
						status = "okay";
						reg = <0x70>;
						compatible = "nxp,pca9546";
						#address-cells = <1>;
						#size-cells = <0>;
						skip_mux_detect = "yes";
						force_bus_start = <CAMERA_I2C_MUX_BUS(0)>;

						i2c@0 {
							status = "okay";
							reg = <0>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							dser0: max96712@29 {
								status = "okay";
								reg = <0x29>;
								compatible = "maxim,max96712";
								csi-mode = "2x4";
								/* 4-lane CSI output towards the Jetson (1300 Mbps/lane). */
								lane_cnt = <4>;
								/* Enabled GMSL links: link 0 (d4xx). */
								link-mask = <0x1>;
								channel = "a";
								pwdn-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
								fangzhu,fg12-12ch-poc-enable;
								/* <serializer-vc deserializer-vc> */
								maxim,link0-vc-remap = <0 0>, <1 1>, <2 2>, <3 3>;
							};

							ser0_a: max9295_a@40 {
								status = "okay";
								reg = <0x40>;
								compatible = "maxim,max9295";
								maxim,gmsl-link-id = <0>;
								maxim,gmsl-dser-device = <&dser0>;
							};

							ds5_3: ds5@0d {
								status = "okay";
								def-addr = <0x10>;
								reg = <0x0d>;
								override_reg = <0x0a>;
								compatible = "intel,d4xx";
								use_sensor_mode_id = "true";
								vcc-supply = <&vdd_cam12v_poc>;
								cam-type = "IMU";
								nvidia,gmsl-ser-device = <&ser0_a>;
								nvidia,gmsl-dser-device = <&dser0>;
								ports {
									#address-cells = <1>;
									#size-cells = <0>;

									port@0 {
										reg = <0>;
										ds5_3_out: endpoint {
											vc-id = <3>;
											port-index = <3>;
											bus-width = <2>;
											remote-endpoint = <&d4xx_csi_in3>;
										};
									};
								};
								mode0 {
									pixel_t = "grey_y16";
									num_lanes = "4";
									csi_pixel_bit_depth = "16";
									active_w = "640";
									active_h = "480";
									tegra_sinterface = "serial_e";
									mclk_khz = "24000";
									pix_clk_hz = "74250000";
									serdes_pix_clk_hz = "325000000"; /* 4 lanes x 1300 Mbps / 16 bpp */
									line_length = "1280"; /* 2200 */
									embedded_metadata_height = "0";
								};
								gmsl-link {
									src-csi-port = "b";
									dst-csi-port = "a";
									serdes-csi-link = "a";
									csi-mode = "1x4";
									st-vc = <0>;
									vc-id = <3>;
									num-lanes = <2>;
								};
							};

							ds5_2: ds5@0c {
								status = "okay";
								def-addr = <0x10>;
								reg = <0x0c>;
								override_reg = <0x0a>;
								compatible = "intel,d4xx";
								use_sensor_mode_id = "true";
								vcc-supply = <&vdd_cam12v_poc>;
								cam-type = "Y8";
								nvidia,gmsl-ser-device = <&ser0_a>;
								nvidia,gmsl-dser-device = <&dser0>;
								ports {
									#address-cells = <1>;
									#size-cells = <0>;

									port@0 {
										reg = <0>;
										ds5_2_out: endpoint {
											vc-id = <2>;
											port-index = <2>;
											bus-width = <2>;
											remote-endpoint = <&d4xx_csi_in2>;
										};
									};
								};
								/* mode0: Y8, mode1: depth D16 */
								mode0 {
									pixel_t = "grey_y16";
									num_lanes = "4";
									csi_pixel_bit_depth = "16";
									active_w = "1280";
									active_h = "720";
									tegra_sinterface = "serial_e";
									mclk_khz = "24000";
									pix_clk_hz = "74250000";
									serdes_pix_clk_hz = "325000000"; /* 4 lanes x 1300 Mbps / 16 bpp */
									line_length = "1280"; /* 2200 */
									embedded_metadata_height = "1";
								};
								gmsl-link {
									src-csi-port = "b";
									dst-csi-port = "a";
									serdes-csi-link = "a";
									csi-mode = "1x4";
									st-vc = <0>;
									vc-id = <2>;
									num-lanes = <2>;
								};
							};

							ds5_1: ds5@0b {
								status = "okay";
								def-addr = <0x10>;
								reg = <0x0b>;
								override_reg = <0x0a>;
								compatible = "intel,d4xx";
								use_sensor_mode_id = "true";
								vcc-supply = <&vdd_cam12v_poc>;
								cam-type = "RGB";
								nvidia,gmsl-ser-device = <&ser0_a>;
								nvidia,gmsl-dser-device = <&dser0>;
								ports {
									#address-cells = <1>;
									#size-cells = <0>;

									port@0 {
										reg = <0>;
										ds5_1_out: endpoint {
											vc-id = <1>;
											port-index = <1>;
											bus-width = <2>;
											remote-endpoint = <&d4xx_csi_in1>;
										};
									};
								};
								mode0 {
									pixel_t = "grey_y16";
									num_lanes = "4";
									csi_pixel_bit_depth = "16";
									active_w = "1920";
									active_h = "1080";
									tegra_sinterface = "serial_e";
									mclk_khz = "24000";
									pix_clk_hz = "74250000";
									serdes_pix_clk_hz = "325000000"; /* 4 lanes x 1300 Mbps / 16 bpp */
									line_length = "1280"; /* 2200 */
									embedded_metadata_height = "1";
								};
								gmsl-link {
									src-csi-port = "b";
									dst-csi-port = "a";
									serdes-csi-link = "a";
									csi-mode = "1x4";
									st-vc = <0>;
									vc-id = <1>;
									num-lanes = <2>;
								};
							};

							ds5_0: ds5@0a {
								status = "okay";
								def-addr = <0x10>;
								reg = <0x0a>;
								compatible = "intel,d4xx";
								use_sensor_mode_id = "true";
								vcc-supply = <&vdd_cam12v_poc>;
								cam-type = "Depth";
								nvidia,gmsl-ser-device = <&ser0_a>;
								nvidia,gmsl-dser-device = <&dser0>;
								ports {
									#address-cells = <1>;
									#size-cells = <0>;

									port@0 {
										reg = <0>;
										ds5_0_out: endpoint {
											vc-id = <0>;
											port-index = <0>;
											bus-width = <2>;
											remote-endpoint = <&d4xx_csi_in0>;
										};
									};
								};
								mode0 {
									pixel_t = "grey_y16";
									num_lanes = "4";
									csi_pixel_bit_depth = "16";
									active_w = "1280";
									active_h = "720";
									tegra_sinterface = "serial_e";
									mclk_khz = "24000";
									pix_clk_hz = "74250000";
									serdes_pix_clk_hz = "325000000"; /* 4 lanes x 1300 Mbps / 16 bpp */
									line_length = "1280"; /* 2200 */
									embedded_metadata_height = "1";
								};
								gmsl-link {
									src-csi-port = "b";
									dst-csi-port = "a";
									serdes-csi-link = "a";
									csi-mode = "1x4";
									st-vc = <0>;
									vc-id = <0>;
									num-lanes = <2>;
								};
							};
						};
					};
				};
			};
		};
	};
};
