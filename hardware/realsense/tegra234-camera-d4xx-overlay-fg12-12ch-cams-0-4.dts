			// 				status = "okay";
			// 				pcl_id = "v4l2_sensor";
			// 				sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9546@70/i2c@2/fzcam_3d@3d";
			// 			};
