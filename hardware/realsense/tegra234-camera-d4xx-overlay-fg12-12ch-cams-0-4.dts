/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>

#define CAM12V_POC	TEGRA234_MAIN_GPIO(AC, 7) //Pin119 --- GPIO12 E10 CAM_VDD_SYS_EN/493 Low enable
#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

#define CAM0_PWDN	TEGRA234_MAIN_GPIO(H, 6)  //Pin93 --- UART4_CTS L49/397 - MAX96724_1 PWDN
#define CAM1_PWDN	TEGRA234_MAIN_GPIO(H, 3)  //Pin95 --- UART4_TX L5/394 - MAX926724_2 PWDN
#define CAM2_PWDN	TEGRA234_MAIN_GPIO(AC, 0) //Pin90 --- GPIO15 F10/486 - MAX9296_3 PWDN
#define CAM3_PWDN	TEGRA234_MAIN_GPIO(AC, 1) //Pin92 --- GPIO16 E9/487 - MAX9296_4 PWDN

#define CAM0_SYNC	TEGRA234_AON_GPIO(AA, 4)  //E59/GPIO6  CAM_FSYNC3/320 -- MAX9296_1 MFP0 (CAM0/1)
#define CAM1_SYNC	TEGRA234_AON_GPIO(BB, 2)  //A62/GPIO10 CAM_FSYNC1/326-- MAX9296_1 MFP5  (CAM0/1  ucsi_cgg IRQ OTG)
#define CAM2_SYNC	TEGRA234_AON_GPIO(CC, 3)  //D60/SPI2_CS0_N CAM_INT4/331 -- MAX9296_2 MFP0 (CAM2/3)
#define CAM3_SYNC	TEGRA234_AON_GPIO(AA, 7)  //F59/GPIO7  CAM_FSYNC2/323  -- MAX9296_2 MFP5  (CAM2/3)
#define CAM_SYNCALL	TEGRA234_AON_GPIO(CC, 0)  //E61/SPI2_CLK CAM_INT1/328 -- MAX9296x4 MFP6

//IIC-9 MAX96724-CSI4/5
//IIC-10 MAX96724-CSI0/1
//IIC-11 MAX9296-CSI6/7 (P/N Switch)
//IIC-12 MAX9296-CSI2/3 (P/N Switch)
/* camera control gpio definitions */
/ {
	overlay-name = "Orin FG12-12ch D457S";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment@1 {
		target-path = "/";
		__overlay__ {
			vdd_cam12v_poc: regulator-vdd-cam12v-poc {
					compatible = "regulator-fixed";
					regulator-name = "vdd-cam12v-poc";
					regulator-min-microvolt = <12000000>;
					regulator-max-microvolt = <12000000>;
					gpio = <&gpio CAM12V_POC GPIO_ACTIVE_HIGH>;
					enable-active-high;
			};
		};
	};

	fragment@0 {
		status = "okay";
		target-path = "/";
		__overlay__ {
			status = "okay";
			tegra-capture-vi {
				status = "okay";
				num-channels = <8>;
				ports {
					status = "okay";
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						status = "okay";
						reg = <0>;
						d4xx_vi_in0: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out0>;
						};
					};
					port@1 {
						status = "okay";
						reg = <1>;
						d4xx_vi_in1: endpoint {
							status = "okay";
							vc-id = <1>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out1>;
						};
					};
					port@2 {
						status = "okay";
						reg = <2>;
						d4xx_vi_in2: endpoint {
							status = "okay";
							vc-id = <2>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out2>;
						};
					};
					port@3 {
						status = "okay";
						reg = <3>;
						d4xx_vi_in3: endpoint {
							status = "okay";
							vc-id = <3>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out3>;
						};
					};
					port@4 {
						status = "okay";
						reg = <4>;
						d4xx_vi_in4: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out4>;
						};
					};
					port@5 {
						status = "okay";
						reg = <5>;
						d4xx_vi_in5: endpoint {
							status = "okay";
							vc-id = <1>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out5>;
						};
					};
					port@6 {
						status = "okay";
						reg = <6>;
						d4xx_vi_in6: endpoint {
							status = "okay";
							vc-id = <2>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out6>;
						};
					};
					port@7 {
						status = "okay";
						reg = <7>;
						d4xx_vi_in7: endpoint {
							status = "okay";
							vc-id = <3>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&d4xx_csi_out7>;
						};
					};
				};
			};

			// tegra-camera-platform {
